{
  "name": "jota",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:domain": "npm run build -w @jota/domain",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "start": "npm run start -w @jota/mobile",
    "ios": "npm run ios -w @jota/mobile --",
    "pods": "npm run pods -w @jota/mobile",
    "web": "npm run web -w @jota/mobile",
    "build:web": "npm run build:web -w @jota/mobile"
  },
  "devDependencies": {
    "prettier": "2.8.8",
    "react": "19.2.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
